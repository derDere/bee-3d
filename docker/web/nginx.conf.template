# nginx des web-Containers: statischer Client unter /, SpacetimeDB unter /stdb/ mit Routen-Allowlist.
# TLS terminiert ein uebergeordneter Proxy; dieser Container spricht intern reines HTTP.
# Vorlage: das nginx-Image ersetzt beim Start ${TRUSTED_PROXY_CIDR} aus der Umgebung (envsubst).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Echte Client-Adresse vom vorgelagerten Proxy, damit die Grenzen je Spieler gelten statt je Proxy.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_conn_zone $binary_remote_addr zone=stdb_conns:10m;
limit_req_zone  $binary_remote_addr zone=stdb_rate:10m rate=5r/s;
# 429 statt 503: der Client deutet 5xx als Serverausfall, 429 als Drosselung.
limit_req_status 429;
limit_conn_status 429;

# Docker-DNS zur Laufzeit: ein neu erzeugter SpacetimeDB-Container mit neuer Adresse bleibt erreichbar.
resolver 127.0.0.11 valid=10s ipv6=off;

# Pfad ohne Query im Log: die Abo-URL traegt ein kurzlebiges Token.
log_format stdb_noquery '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    set $stdb_upstream spacetimedb:3000;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Gehashte Build-Dateien duerfen lange im Cache bleiben.
    location /assets/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    # --- SpacetimeDB: nur Spiel-WebSocket, Token-Tausch und Ping -------------
    location = /stdb/v1/database/bee-world/subscribe {
        access_log /var/log/nginx/access.log stdb_noquery;
        limit_conn stdb_conns 8;
        limit_req zone=stdb_rate burst=20 nodelay;
        proxy_pass http://$stdb_upstream/v1/database/bee-world/subscribe$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
    }

    location = /stdb/v1/identity/websocket-token {
        limit_except POST { deny all; }
        limit_req zone=stdb_rate burst=20 nodelay;
        client_max_body_size 64k;
        proxy_pass http://$stdb_upstream/v1/identity/websocket-token;
        proxy_set_header Host $host;
    }

    location = /stdb/v1/ping {
        proxy_pass http://$stdb_upstream/v1/ping;
    }

    location /stdb/ {
        return 404;
    }
}
