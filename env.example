# ===========================================================================
# env.example - vollstaendige Vorlage fuer ein lauffaehiges DEV-System.
# "make start" kopiert diese Datei einmalig nach .env, falls noch keine .env
# vorhanden ist. Eine bereits vorhandene .env bleibt unangetastet.
# Vite liest dieselbe Datei (Variablen mit Praefix VITE_).
# ===========================================================================

# --- Environment -----------------------------------------------------------
# Stage dieses Laufs: dev | test | qs | prod. dev startet den Vite-Dev-Server
# mit Hot Reload auf dem Host; alle anderen Stages liefern dist/ ueber den
# web-Container aus.
APP_ENV=dev

# --- Compose ---------------------------------------------------------------
# Name des Compose-Projekts = Name dieses Stacks.
COMPOSE_PROJECT_NAME=bee-3d
# Zusaetzliche Dienste: leer in dev (Client kommt vom Vite-Dev-Server),
# "web" in test/qs/prod (nginx mit dem gebauten Client).
COMPOSE_PROFILES=

# --- Veroeffentlichte Host-Ports -------------------------------------------
# SpacetimeDB bindet nur an 127.0.0.1 (CLI, MCP, Dev-Client).
SPACETIMEDB_PORT=3000
# nginx mit dem gebauten Client (Profil web). WEB_BIND ist die Host-Adresse des Ports:
# 127.0.0.1, wenn der vorgelagerte TLS-Proxy auf demselben Host laeuft.
WEB_PORT=8080
WEB_BIND=127.0.0.1
# Adressbereich des vorgelagerten TLS-Proxys; nur ihm glaubt nginx die Client-Adresse aus
# X-Forwarded-For (Grenzen je Spieler statt je Proxy).
TRUSTED_PROXY_CIDR=127.0.0.1/32

# --- SpacetimeDB -----------------------------------------------------------
SPACETIMEDB_DATABASE=bee-world
SPACETIMEDB_URL=http://127.0.0.1:3000

# --- Client (Vite) ---------------------------------------------------------
# Dev-Client verbindet direkt mit dem Container-Port; leer = gleicher Host
# unter /stdb/ (Produktion hinter dem Proxy des web-Containers).
VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB_NAME=bee-world

# --- Eingangstuer fuer "make open" -----------------------------------------
APP_URL=http://127.0.0.1:5173/
